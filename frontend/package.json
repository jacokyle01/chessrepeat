    "@types/chess.js": "^0.13.7",
    "@types/node": "^22.5.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vitest": "^3.2.7"
  },
