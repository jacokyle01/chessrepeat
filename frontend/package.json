    "lucide-react": "^0.511.0",
    "npm": "^11.10.0",
    "prettier": "^3.2.5",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.7",
    "react": "^19.1.0",
