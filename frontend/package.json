{
  "name": "chess-prep-2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=playground",
    "test:e2e:all": "E2E_BACKEND=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:db": "docker run --rm -d --name chessrepeat-e2e-pg -e POSTGRES_USER=e2e -e POSTGRES_PASSWORD=e2e -e POSTGRES_DB=postgres -p 5433:5432 postgres:16-alpine",
    "test:e2e:db:stop": "docker stop chessrepeat-e2e-pg"
  },
  "engines": {
    "pnpm": "9999.9999.9999",
    "node": "23.0.0",
    "npm": "10.9.0"
  },
